# Unified diff context lines intentionally contain a single space.
docs/benchmarks/*.patch -whitespace
# Preserve pinned artifact/corpus hashes and source fingerprints on Windows.
*.json text eol=lf
*.jsonl text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.patch text eol=lf
# Preserve the upstream OFL license text, including its original line endings/spaces.
peps/licenses/LATO_OFL.txt text eol=lf whitespace=-blank-at-eol
peps/licenses/SOURCE_SERIF_4_OFL.txt text eol=lf whitespace=-blank-at-eol

# Upstream reStructuredText license headings contain seven equals signs.
peps/licenses/EXTRACTION_DEPENDENCIES.txt conflict-marker-size=32
